source = $HOME/.config/hypr/latte.conf

$font = RedHatDisplay
$color = #FFFFFF

# GENERAL
general {
  hide_cursor = true
}

# BACKGROUND
background {
  monitor =
  path = ~/Pictures/wallpapers/perlica-facing-talos-II.jpg
  blur_passes = 1
  blur_size = 1
}

# TIME
label {
  monitor =
  text = $TIME
  color = $color
  font_size = 60
  font_family = $font
  font-weight = 900
  position = 0, -30
  halign = center
  valign = top
}

# DATE
label {
  monitor =
  text = cmd[update:43200000] date +"%A, %d %B %Y"
  color = $color
  font_size = 24
  font_family = $font
  font-weight = 600
  position = 0, -150
  halign = center
  valign = top
}

# FINGERPRINT
{
  monitor = "";
  text = "$FPRINTPROMPT";
  color = "$text";
  font_size = 14;
  font_family = $font;
  position = "0, -107";
  halign = "center";
  valign = "center";
}

# USER AVATAR
image {
  monitor =
  path = ~/.face
  size = 100
  border_color = $color
  position = 0, 75
  halign = center
  valign = center
}

input-field {
  monitor =
  size = 280, 40
  outline_thickness = 4
  dots_size = 0.2
  dots_spacing = 0.2
  dots_center = true
  outer_color = $color
  inner_color = $surface0
  font_color = $color
  fade_on_empty = false
  placeholder_text = <span foreground="##$textAlpha"><i>󰌾 Logged in as </i><span foreground="##$colorAlpha">$USER</span></span>
  hide_input = false
  check_color = $color
  fail_color = $red
  fail_text = <i>$FAIL <b>($ATTEMPTS)</b></i>
  capslock_color = $yellow
  position = 0, -47
  halign = center
  valign = center
}
